{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/administration",
      "regex": "^/administration(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/administration(?:/)?$"
    },
    {
      "page": "/auth/signout",
      "regex": "^/auth/signout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/signout(?:/)?$"
    },
    {
      "page": "/connexion",
      "regex": "^/connexion(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/connexion(?:/)?$"
    },
    {
      "page": "/educateur",
      "regex": "^/educateur(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/educateur(?:/)?$"
    },
    {
      "page": "/espace-jeune",
      "regex": "^/espace\\-jeune(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/espace\\-jeune(?:/)?$"
    },
    {
      "page": "/inscription",
      "regex": "^/inscription(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/inscription(?:/)?$"
    },
    {
      "page": "/manifest.webmanifest",
      "regex": "^/manifest\\.webmanifest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifest\\.webmanifest(?:/)?$"
    },
    {
      "page": "/mot-de-passe-oublie",
      "regex": "^/mot\\-de\\-passe\\-oublie(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mot\\-de\\-passe\\-oublie(?:/)?$"
    },
    {
      "page": "/reinitialiser-mot-de-passe",
      "regex": "^/reinitialiser\\-mot\\-de\\-passe(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reinitialiser\\-mot\\-de\\-passe(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}